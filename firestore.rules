rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function autenticado() {
      return request.auth != null;
    }

    function souUsuario(userId) {
      return autenticado() && request.auth.uid == userId;
    }

    function membroDoProjeto(projectId) {
      return autenticado()
        && request.auth.uid in get(
          /databases/$(database)/documents/projects/$(projectId)
        ).data.memberIds;
    }

    function administradorDoProjeto(projectId) {
      return autenticado()
        && get(
          /databases/$(database)/documents/projects/$(projectId)
        ).data.adminId == request.auth.uid;
    }

    function entrandoNoProjeto() {
      return autenticado()
        && !(request.auth.uid in resource.data.memberIds)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['memberIds', 'memberProfiles', 'updatedAt'])
        && request.resource.data.memberIds.toSet()
          == resource.data.memberIds.toSet().union([request.auth.uid].toSet())
        && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
        && request.resource.data.memberProfiles[request.auth.uid].email == request.auth.token.email;
    }

    match /users/{userId} {
      allow create: if souUsuario(userId);
      allow read, update, delete: if souUsuario(userId);
    }

    match /projects/{projectId} {
      allow create: if autenticado()
        && request.resource.data.adminId == request.auth.uid
        && request.auth.uid in request.resource.data.memberIds;

      // Um usuário autenticado pode consultar um projeto se conhecer o código
      // exato. Listagens continuam limitadas aos projetos dos quais é membro.
      allow get: if autenticado();
      allow list: if autenticado() && request.auth.uid in resource.data.memberIds;
      allow update: if administradorDoProjeto(projectId) || entrandoNoProjeto();
      allow delete: if administradorDoProjeto(projectId);
    }

    match /projects/{projectId}/{document=**} {
      allow read: if membroDoProjeto(projectId);
      allow create: if membroDoProjeto(projectId);
      allow update, delete: if administradorDoProjeto(projectId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
